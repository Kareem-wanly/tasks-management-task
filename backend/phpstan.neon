includes:
    - vendor/larastan/larastan/extension.neon
    # Legacy findings only (PR4a). New code is never added to the baseline; it shrinks to zero in PR10.
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
    # Legacy project: raised per PR, up to 9 (PR10b: 8).
    level: 8

services:
    # transaction() on the injected ConnectionInterface returns what its callback returns.
    -
        class: PHPStanExtensions\ConnectionTransactionReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
