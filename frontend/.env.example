# Frontend Environment Variables Example

# Backend REST API base URL. Leave it unset to use /api on the same address:
# the dev server forwards /api (and Laravel's /auth/bitrix/* paths) to BACKEND_URL.
# VITE_API_BASE_URL=/api

# Where Laravel runs locally (used by the dev server's proxy only).
# BACKEND_URL=http://127.0.0.1:8000
